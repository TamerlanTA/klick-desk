# Скопируй этот файл в .env.local и заполни значения. .env.local в git не попадает.
# Все переменные начинаются с VITE_: только такие Vite передаёт в браузерный код.

# Firebase: console.firebase.google.com → проект → Project settings → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TMDB: themoviedb.org → Settings → API → API Key (v3 auth)
VITE_TMDB_API_KEY=
